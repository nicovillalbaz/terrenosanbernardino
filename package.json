{
  "name": "real-estate-landing",
  "version": "1.0.0",
  "description": "Landing page para la venta de terreno inmobiliario - optimized para GitHub Pages",
  "main": "dist/main.js",
  "scripts": {
    "build": "node build.js",
    "dev": "webpack serve --mode development",
    "deploy": "gh-pages -d dist",
    "lint": "eslint src/ --fix",
    "format": "prettier --write src/",
    "test": "jest",
    "optimize": "node optimize.js"
  },
  "keywords": [
    "landing-page",
    "real-estate",
    "inmobiliario",
    "terreno",
    "venta",
    "github-pages"
  ],
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usuario/real-estate-landing.git"
  },
  "bugs": {
    "url": "https://github.com/usuario/real-estate-landing/issues"
  },
  "homepage": "https://usuario.github.io/real-estate-landing",
  "devDependencies": {
    "autoprefixer": "^10.4.16",
    "css-loader": "^6.9.1",
    "css-minimizer-webpack-plugin": "^5.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-webpack-plugin": "^4.0.1",
    "html-webpack-plugin": "^5.6.0",
    "image-minimizer-webpack-plugin": "^3.0.3",
    "jest": "^29.7.0",
    "mini-css-extract-plugin": "^2.8.0",
    "postcss": "^8.4.35",
    "postcss-loader": "^7.3.3",
    "prettier": "^3.2.5",
    "style-loader": "^6.0.0",
    "tailwindcss": "^3.4.1",
    "terser-webpack-plugin": "^5.3.10",
    "webpack": "^5.93.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.2"
  },
  "dependencies": {
    "swiper": "^11.1.3",
    "@fortawesome/fontawesome-free": "^6.5.1",
    "date-fns": "^2.30.0"
  },
  "browserslist": ">= 0.25%, not dead, not op_mini all",
  "eslintConfig": {
    "extends": ["eslint:recommended", "plugin:prettier/recommended"],
    "env": {
      "browser": true,
      "node": true,
      "es2021": true
    },
    "rules": {
      "semi": ["error", "always"],
      "quotes": ["error", "double"],
      "eqeqeq": ["error", "smart"],
      "curly": ["error", "all"],
      "no-console": ["warn", { "allow": ["warn", "error"] }],
      "prefer-const": "error",
      "object-shorthand": "error"
    }
  },
  "prettier": {
    "semi": true,
    "singleQuote": false,
    "tabWidth": 2,
    "trailingComma": "es5",
    "arrowParens": "avoid"
  }
}
